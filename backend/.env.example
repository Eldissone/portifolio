# Database (pooler — usar na app em runtime)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# Ligação directa — obrigatória para prisma db push / migrations
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_key

# Supabase Storage (uploads no servidor)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=portfolio-uploads
SUPABASE_PRIVATE_BUCKET=portfolio-private

# Download security
DOWNLOAD_URL_TTL_SECONDS=900
DOWNLOAD_TOKEN_TTL_HOURS=72
DOWNLOAD_TOKEN_MAX_USES=3

# Pagamento manual (instruções mostradas ao cliente)
PAYMENT_WHATSAPP=244933170799
PAYMENT_BANK_DETAILS=Banco / IBAN — actualiza com os teus dados
PAYMENT_MULTICAIXA=Referência Multicaixa — actualiza com os teus dados

# Frontend URL (optional)
FRONTEND_URL=https://www.eldissone.com
