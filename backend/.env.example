# Database (pooler — usar na app em runtime)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# Ligação directa — obrigatória para prisma db push / migrations
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_key

# Supabase Storage (uploads no servidor)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=portfolio-uploads

# Frontend URL (optional)
FRONTEND_URL=https://www.eldissone.com
